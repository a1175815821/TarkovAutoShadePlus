<Window x:Class="TarkovAutoShadePlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TarkovAutoShadePlus"
        Width="1280" Height="820"
        MinWidth="1060" MinHeight="700"
        Background="{StaticResource CrtBlackBrush}"
        FontFamily="{StaticResource FontUi}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- ==================== 顶栏 ==================== -->
        <Border Grid.Row="0" Background="{StaticResource CrtSurfaceBrush}"
                BorderBrush="{StaticResource CrtBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFF0A03C" Offset="0"/>
                                <GradientStop Color="#FFC97A1F" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="TA" FontSize="14" FontWeight="ExtraBold"
                                   Foreground="{StaticResource OnAmberBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TarkovAutoShadePlus" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource PhosphorWhiteBrush}"
                               VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <Border Background="{StaticResource AmberFaintBrush}" BorderBrush="{StaticResource AmberAlertBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="7,2" VerticalAlignment="Center">
                        <TextBlock Text="v2.0" FontFamily="{StaticResource FontMono}" FontSize="10"
                                   FontWeight="Bold" Foreground="{StaticResource AmberAlertBrush}"/>
                    </Border>
                </StackPanel>

                <!-- 状态徽标 + 当前预设 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                    <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="13" Padding="11,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                     Fill="{StaticResource TerminalGreenBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RunStateText" Text="未运行" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource PhosphorDimBrush}"
                                       VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource CrtBorderBrush}"
                            BorderThickness="1" CornerRadius="13" Padding="11,5" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="预设" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="ModeText" Text="自动分析" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource AmberAlertBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 操作通知（代码后置控制） -->
                <Border x:Name="ActionMessagePanel" Grid.Column="3"
                        Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,5"
                        VerticalAlignment="Center" Margin="0,0,10,0"
                        Opacity="0" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ActionMessageDot" Width="7" Height="7"
                                 Fill="{StaticResource InfoBlueBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActionMessageTypeText" Text="" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{StaticResource InfoBlueBrush}"
                                   VerticalAlignment="Center" Margin="7,0,0,0"/>
                        <TextBlock x:Name="ActionMessageText" Text="" FontSize="11.5"
                                   Foreground="{StaticResource PhosphorWhiteBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <Button x:Name="AboutButton" Grid.Column="4" Content="关于"
                        Style="{StaticResource TacticalButton}" Height="30" Padding="14,0"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ==================== 主区 ==================== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="352"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="368"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左列：设备与运行 ========== -->
            <ScrollViewer Grid.Column="0" Style="{StaticResource PanelScrollViewer}">
                <StackPanel Margin="0,0,6,0">

                    <!-- 显示器模式 -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="显示器模式" Style="{StaticResource SectionHeader}"/>
                                </StackPanel>
                                <Button x:Name="RefreshDisplayButton" Content="刷新显示器"
                                        Style="{StaticResource TacticalButton}" Height="26" Padding="10,0"
                                        FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>

                            <ComboBox x:Name="DisplayModeComboBox" Style="{StaticResource TacticalComboBox}"
                                      SelectedIndex="0" Margin="0,0,0,12">
                                <ComboBoxItem Content="单屏模式"/>
                                <ComboBoxItem Content="多屏模式"/>
                            </ComboBox>

                            <Border x:Name="SingleDisplayPanel" BorderThickness="0" Padding="0">
                                <StackPanel>
                                    <TextBlock Text="目标显示器" Style="{StaticResource PanelHint}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="DisplayComboBox" Style="{StaticResource TacticalComboBox}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="MultiDisplayPanel" BorderThickness="0" Padding="0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="应用显示器（可多选，至少勾选一个）" Style="{StaticResource PanelHint}" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="DisplaySelectionPanel"/>
                                    <TextBlock Text="同一套滤镜会同步应用到勾选的显示器。" Style="{StaticResource PanelHint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 截图目录 -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="截图目录" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <TextBlock x:Name="FolderPath" Text="未找到截图目录"
                                       FontFamily="{StaticResource FontMono}" FontSize="11"
                                       Foreground="{StaticResource AmberAlertBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                            <StackPanel x:Name="FolderSelectionPanel" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BrowseFolderButton" Grid.Column="0" Content="选择目录"
                                        Style="{StaticResource TacticalButtonPrimary}"/>
                                <Button x:Name="ResetFolderButton" Grid.Column="2" Content="重新发现"
                                        Style="{StaticResource TacticalButton}" Padding="12,0"/>
                            </Grid>
                            <TextBlock Text="自动发现原版 / 竞技场截图目录并同时监听；点击路径可添加目录。" Style="{StaticResource PanelHint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 运行控制 -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="运行控制" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <Button x:Name="AnalyzeButton" Content="立即分析最新截图"
                                    Style="{StaticResource TacticalButton}" Margin="0,0,0,8"/>
                            <Button x:Name="ToggleButton" Content="开启滤镜  F8"
                                    Style="{StaticResource TacticalButtonPrimary}" Height="42" FontSize="13.5"
                                    Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="全局快捷键" Style="{StaticResource ParamLabel}"/>
                                <Border Grid.Column="1" Background="{StaticResource InsetBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1,1,1,2.5"
                                        CornerRadius="4" Padding="10,4" Margin="12,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock x:Name="HotkeyText" Text="F8" FontFamily="{StaticResource FontMono}"
                                               FontSize="12.5" FontWeight="Bold"
                                               Foreground="{StaticResource AmberAlertBrush}"/>
                                </Border>
                                <Button x:Name="ChangeHotkeyButton" Grid.Column="2" Content="设置"
                                        Style="{StaticResource TacticalButton}" Height="28" Padding="12,0" FontSize="11.5"/>
                            </Grid>

                            <CheckBox x:Name="SmoothTransitionCheckBox" Content="滤镜平滑切换"
                                      Style="{StaticResource TacticalCheckBox}" IsChecked="True"/>
                        </StackPanel>
                    </Border>

                    <!-- 实时全自动 -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="实时全自动" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <CheckBox x:Name="RealtimeCheckBox" Content="启用实时检测（无需截图）"
                                      Style="{StaticResource TacticalCheckBox}" Margin="0,0,0,10"
                                      ToolTip="按间隔抓屏分析并平滑切换，和截图监听可同时开。"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="实时状态" Style="{StaticResource PanelHint}"/>
                                <TextBlock x:Name="RealtimeStatusText" Text="未启用"
                                           FontFamily="{StaticResource FontMono}" FontSize="11"
                                           Foreground="{StaticResource PhosphorDimBrush}"
                                           HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="采样间隔" Style="{StaticResource ParamLabel}"
                                           ToolTip="抓屏分析一次的时间间隔。越短跟随越快，占用越高。"/>
                                <TextBlock x:Name="RealtimeIntervalValue" Text="1.2s" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider x:Name="RealtimeIntervalSlider" Style="{StaticResource TacticalSlider}"
                                    Minimum="600" Maximum="3000" Value="1200"
                                    TickFrequency="100" IsSnapToTickEnabled="True" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="跟随灵敏度" Style="{StaticResource ParamLabel}"
                                           ToolTip="保守换得慢但最稳，灵敏跟得快但易受枪火闪光影响。夜视切换始终优先。"/>
                            </Grid>
                            <ComboBox x:Name="RealtimeSensitivityComboBox" Style="{StaticResource TacticalComboBox}"
                                      SelectedIndex="1" Margin="0,0,0,6">
                                <ComboBoxItem Content="保守"/>
                                <ComboBoxItem Content="均衡"/>
                                <ComboBoxItem Content="灵敏"/>
                            </ComboBox>
                            <TextBlock Text="仅 SDR / 无边框窗口有效，独占全屏与 HDR 下 Gamma 会被系统忽略；切出游戏自动暂停。"
                                       Style="{StaticResource PanelHint}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 滤镜自动启停 -->
                    <Border x:Name="ProcessWatchPanel" Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="滤镜自动启停" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <CheckBox x:Name="ProcessWatchCheckBox" Content="切出游戏时自动关闭滤镜"
                                      Style="{StaticResource TacticalCheckBox}" Margin="0,0,0,10"/>
                            <StackPanel x:Name="ProcessWatchControls">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="前台状态" Style="{StaticResource PanelHint}"/>
                                    <TextBlock x:Name="ProcessWatchStatusText" Text="未启用"
                                               FontFamily="{StaticResource FontMono}" FontSize="11"
                                               Foreground="{StaticResource PhosphorDimBrush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel x:Name="ProcessSelectionPanel" Margin="0,0,0,8"/>
                                <TextBlock Text="从运行中的进程添加" Style="{StaticResource PanelHint}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ProcessComboBox" Style="{StaticResource TacticalComboBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 显示器硬件（DDC/CI） -->
                    <Border x:Name="MonitorHardwarePanel" Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="显示器硬件" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <TextBlock x:Name="MonitorHardwareDetail" Text="检测显示器 DDC/CI…"
                                       Style="{StaticResource PanelHint}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="显示器亮度" Style="{StaticResource ParamLabel}"
                                           ToolTip="通过 DDC/CI 调整显示器硬件亮度。"/>
                                <TextBlock x:Name="MonitorBrightnessValue" Text="--" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider x:Name="MonitorBrightnessSlider" Style="{StaticResource TacticalSlider}"
                                    Minimum="0" Maximum="100" IsEnabled="False" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="显示器对比度" Style="{StaticResource ParamLabel}"
                                           ToolTip="通过 DDC/CI 调整显示器硬件对比度。"/>
                                <TextBlock x:Name="MonitorContrastValue" Text="--" Style="{StaticResource ParamValue}"/>
                            </Grid>
                            <Slider x:Name="MonitorContrastSlider" Style="{StaticResource TacticalSlider}"
                                    Minimum="0" Maximum="100" IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ========== 中列：预览与分析 ========== -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 预览面板 -->
                <Border Style="{StaticResource TacticalPanel}" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="4,0,4,12">
                            <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="滤镜预览" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="拖动中线比较原图与滤镜效果" Style="{StaticResource PanelHint}"
                                       VerticalAlignment="Center" Margin="14,0,0,0"/>
                        </StackPanel>

                        <Border x:Name="PreviewBorder" Grid.Row="1"
                                Background="{StaticResource InsetBrush}"
                                BorderBrush="{StaticResource CrtBorderBrush}" BorderThickness="1"
                                CornerRadius="8">
                            <Grid x:Name="PreviewContainer">
                                <!-- PreviewControl 由代码后置插入 -->
                                <Grid x:Name="PreviewEmptyState">
                                    <Grid.Background>
                                        <DrawingBrush Viewport="0,0,32,32" ViewportUnits="Absolute" TileMode="Tile">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="{StaticResource InsetBrush}">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="0,0,32,32"/>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing>
                                                        <GeometryDrawing.Pen>
                                                            <Pen Brush="#FF1E2833" Thickness="1"/>
                                                        </GeometryDrawing.Pen>
                                                        <GeometryDrawing.Geometry>
                                                            <GeometryGroup>
                                                                <LineGeometry StartPoint="0,0" EndPoint="32,0"/>
                                                                <LineGeometry StartPoint="0,0" EndPoint="0,32"/>
                                                            </GeometryGroup>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Grid.Background>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="44" Height="3" CornerRadius="1.5"
                                                Background="{StaticResource AmberAlertBrush}"
                                                HorizontalAlignment="Center" Margin="0,0,0,14"/>
                                        <TextBlock Text="等待游戏截图" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PhosphorWhiteBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="在游戏中生成截图后自动分析，或点击「立即分析最新截图」"
                                                   FontSize="12" Foreground="{StaticResource PhosphorDimBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                        <Border Background="{StaticResource AmberFaintBrush}"
                                                BorderBrush="{StaticResource AmberAlertBrush}" BorderThickness="1"
                                                CornerRadius="11" Padding="12,4" HorizontalAlignment="Center">
                                            <TextBlock Text="状态：监听中" FontFamily="{StaticResource FontMono}"
                                                       FontSize="10.5" FontWeight="Bold"
                                                       Foreground="{StaticResource AmberAlertBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 分析读数 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource CrtSurfaceBrush}"
                            BorderBrush="{StaticResource CrtBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="暗部 P10" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="P10Value" Text="--" FontFamily="{StaticResource FontMono}"
                                       FontSize="19" FontWeight="Bold" Margin="0,2,0,6"
                                       Foreground="{StaticResource PhosphorWhiteBrush}"/>
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource ElevatedBrush}">
                                <Border Width="26" HorizontalAlignment="Left" CornerRadius="1.5"
                                        Background="{StaticResource InfoBlueBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource CrtSurfaceBrush}"
                            BorderBrush="{StaticResource CrtBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="中间调 P50" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="MedianValue" Text="--" FontFamily="{StaticResource FontMono}"
                                       FontSize="19" FontWeight="Bold" Margin="0,2,0,6"
                                       Foreground="{StaticResource PhosphorWhiteBrush}"/>
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource ElevatedBrush}">
                                <Border Width="48" HorizontalAlignment="Left" CornerRadius="1.5"
                                        Background="{StaticResource PhosphorDimBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{StaticResource CrtSurfaceBrush}"
                            BorderBrush="{StaticResource CrtBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="高光 P95" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="P95Value" Text="--" FontFamily="{StaticResource FontMono}"
                                       FontSize="19" FontWeight="Bold" Margin="0,2,0,6"
                                       Foreground="{StaticResource PhosphorWhiteBrush}"/>
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource ElevatedBrush}">
                                <Border Width="86" HorizontalAlignment="Left" CornerRadius="1.5"
                                        Background="{StaticResource AmberAlertBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="6" Background="{StaticResource CrtSurfaceBrush}"
                            BorderBrush="{StaticResource CrtBorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="动态范围" Style="{StaticResource MetricLabel}"/>
                            <TextBlock x:Name="DynamicRangeValue" Text="--" FontFamily="{StaticResource FontMono}"
                                       FontSize="19" FontWeight="Bold" Margin="0,2,0,6"
                                       Foreground="{StaticResource AmberAlertBrush}"/>
                            <Border Height="3" CornerRadius="1.5" Background="{StaticResource ElevatedBrush}">
                                <Border Width="72" HorizontalAlignment="Left" CornerRadius="1.5"
                                        Background="{StaticResource AmberAlertBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ========== 右列：参数 ========== -->
            <ScrollViewer Grid.Column="4" Style="{StaticResource PanelScrollViewer}">
                <StackPanel Margin="0,0,6,0">

                    <!-- 参数档案 -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="参数档案" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ProfileEftButton" Grid.Column="0" Content="原版"
                                        Style="{StaticResource TacticalButton}" Margin="0,0,5,0"
                                        ToolTip="编辑原版（EscapeFromTarkov.exe）的滤镜参数"/>
                                <Button x:Name="ProfileArenaButton" Grid.Column="1" Content="竞技场"
                                        Style="{StaticResource TacticalButton}" Margin="5,0,0,0"
                                        ToolTip="编辑竞技场（EscapeFromTarkovArena.exe）的滤镜参数"/>
                            </Grid>
                            <CheckBox x:Name="ProfileFollowGameCheckBox" Content="跟随前台游戏自动切换"
                                      Style="{StaticResource TacticalCheckBox}" Margin="0,0,0,8"
                                      ToolTip="开启后按当前前台游戏自动取用对应档案；关闭则锁定在上面选中的档案。"/>
                            <TextBlock x:Name="ProfileStatusText" Text="当前生效：原版"
                                       Style="{StaticResource PanelHint}"/>
                        </StackPanel>
                    </Border>

                    <!-- 快捷预设 -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="快捷预设" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <ComboBox x:Name="PresetComboBox" Style="{StaticResource TacticalComboBox}"
                                      SelectedIndex="0" Margin="0,0,0,8">
                                <ComboBoxItem Content="自动分析"/>
                                <ComboBoxItem Content="自然中性"/>
                                <ComboBoxItem Content="室内柔和"/>
                                <ComboBoxItem Content="夜视护眼"/>
                                <ComboBoxItem Content="高光保护"/>
                                <ComboBoxItem Content="自定义预设"/>
                            </ComboBox>
                            <Button x:Name="ResetDefaultsButton" Content="恢复默认数值"
                                    Style="{StaticResource TacticalButton}"
                                    BorderBrush="{StaticResource HazardRedBrush}" Foreground="{StaticResource HazardRedBrush}"/>
                            <TextBlock Text="预设只是参数组合，最终曲线仍按每张截图重新计算。" Style="{StaticResource PanelHint}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 自动算法偏好 -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="自动算法偏好" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <TextBlock Text="控制算法面对不同环境时的倾向" Style="{StaticResource PanelHint}" Margin="0,0,0,14"/>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="暗部可见度" Style="{StaticResource ParamLabel}"
                                               ToolTip="提高暗场增强倾向。数值越高，暗场允许的提亮范围越大。"/>
                                    <TextBlock x:Name="ShadowValue" Text="70" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="ShadowSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="0" Maximum="100" Value="70"
                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="高光保护" Style="{StaticResource ParamLabel}"
                                               ToolTip="保护天空、窗户、灯光和高亮区域。"/>
                                    <TextBlock x:Name="HighlightValue" Text="76" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="HighlightSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="0" Maximum="100" Value="76"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="色偏校正" Style="{StaticResource ParamLabel}"
                                               ToolTip="根据截图 RGB 平均值进行轻量通道平衡。"/>
                                    <TextBlock x:Name="ColorValue" Text="72" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="ColorSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="0" Maximum="100" Value="72"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="室内柔和" Style="{StaticResource ParamLabel}"
                                               ToolTip="检测到室内特征时，降低中间调冲击并增加柔和压缩。"/>
                                    <TextBlock x:Name="IndoorValue" Text="72" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="IndoorSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="0" Maximum="100" Value="72"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="过亮 / 夜视保护" Style="{StaticResource ParamLabel}"
                                               ToolTip="保护强光、逆光和偏绿夜视场景，避免自动增强过度。"/>
                                    <TextBlock x:Name="GuardValue" Text="88" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="GuardSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="0" Maximum="100" Value="88"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="黑位 / 去灰" Style="{StaticResource ParamLabel}"
                                               ToolTip="提亮暗部后恢复黑色分离度，减少灰雾感。"/>
                                    <TextBlock x:Name="BlackValue" Text="56" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="BlackSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="0" Maximum="100" Value="56"/>
                            </StackPanel>

                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="最大调整强度" Style="{StaticResource ParamLabel}"
                                               ToolTip="生成曲线与原始曲线混合的最大比例。"/>
                                    <TextBlock x:Name="StrengthValue" Text="82" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="StrengthSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="0" Maximum="100" Value="82"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 画面微调 -->
                    <Border Style="{StaticResource TacticalPanel}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AmberAlertBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="画面微调" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            <TextBlock Text="在自动分析结果上的固定偏移，0 为不调整" Style="{StaticResource PanelHint}" Margin="0,0,0,14"/>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="亮度微调" Style="{StaticResource ParamLabel}"
                                               ToolTip="在自动结果基础上提高或降低整体曝光倾向。"/>
                                    <TextBlock x:Name="ExposureValue" Text="0" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="ExposureSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="-20" Maximum="20" Value="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="对比度微调" Style="{StaticResource ParamLabel}"
                                               ToolTip="在自动结果基础上增加或减少明暗分离。"/>
                                    <TextBlock x:Name="ContrastValue" Text="0" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="ContrastSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="-20" Maximum="20" Value="0"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,16">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="暖色舒适度" Style="{StaticResource ParamLabel}"
                                               ToolTip="正值增加暖色倾向，负值增加冷色倾向。"/>
                                    <TextBlock x:Name="WarmthValue" Text="0" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="WarmthSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="-20" Maximum="20" Value="0"/>
                            </StackPanel>

                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="色彩浓度" Style="{StaticResource ParamLabel}"
                                               ToolTip="调整颜色通道相对于画面亮度的距离。"/>
                                    <TextBlock x:Name="SaturationValue" Text="0" Style="{StaticResource ParamValue}"/>
                                </Grid>
                                <Slider x:Name="SaturationSlider" Style="{StaticResource TacticalSlider}"
                                        Minimum="-20" Maximum="20" Value="0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== 底部指标栏 ==================== -->
        <Border Grid.Row="2" Background="{StaticResource CrtSurfaceBrush}"
                BorderBrush="{StaticResource CrtBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="等效 GAMMA" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="GammaMetric" Text="--" Style="{StaticResource MetricValue}" Margin="8,0,0,0"/>
                    <Border Width="1" Height="14" Background="{StaticResource CrtBorderBrush}" Margin="20,0"/>
                    <TextBlock Text="亮度调整" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="BrightnessMetric" Text="--" Style="{StaticResource MetricValue}" Margin="8,0,0,0"/>
                    <Border Width="1" Height="14" Background="{StaticResource CrtBorderBrush}" Margin="20,0"/>
                    <TextBlock Text="对比度调整" Style="{StaticResource MetricLabel}"/>
                    <TextBlock x:Name="ContrastMetric" Text="--" Style="{StaticResource MetricValue}" Margin="8,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TimestampText" Text="—" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontFamily="{StaticResource FontMono}"
                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
