<!--
  TarkovAutoShade UI v2.2 — 现代专业视觉分析工作站
  设计令牌与控件样式。深色四层级底色 + 琥珀品牌色。
  注意：CrtSurfaceBrush / PhosphorWhiteBrush / PhosphorDimBrush / AmberAlertBrush /
        TerminalGreenBrush / HazardRedBrush / FontUi / FontMono / FontDisplay /
        TacticalButton / TacticalButtonPrimary / TacticalButtonActive / TacticalCheckBox
  为代码后置 (MainWindow.xaml.cs) 通过 FindResource 引用的契约键，禁止改名。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== 色彩令牌 ==================== -->
    <Color x:Key="ColBase">#FF0D1117</Color>
    <Color x:Key="ColSurface">#FF151B23</Color>
    <Color x:Key="ColElevated">#FF1C242F</Color>
    <Color x:Key="ColInset">#FF0A0E13</Color>
    <Color x:Key="ColBorderSubtle">#FF26303C</Color>
    <Color x:Key="ColBorderStrong">#FF36424F</Color>
    <Color x:Key="ColTextPrimary">#FFE9EEF4</Color>
    <Color x:Key="ColTextSecondary">#FF9DA9B6</Color>
    <Color x:Key="ColTextMuted">#FF5F6B7A</Color>
    <Color x:Key="ColAmber">#FFF0A03C</Color>
    <Color x:Key="ColAmberStrong">#FFFFB84D</Color>
    <Color x:Key="ColSuccess">#FF43B581</Color>
    <Color x:Key="ColWarning">#FFE8B33D</Color>
    <Color x:Key="ColDanger">#FFE5534B</Color>
    <Color x:Key="ColInfo">#FF4E9CFF</Color>
    <Color x:Key="ColChannelR">#FFF2545B</Color>
    <Color x:Key="ColChannelG">#FF3FC97E</Color>
    <Color x:Key="ColChannelB">#FF4E9CFF</Color>

    <!-- ==================== 画刷（契约键 + 语义键） ==================== -->
    <SolidColorBrush x:Key="CrtBlackBrush" Color="{StaticResource ColBase}"/>
    <SolidColorBrush x:Key="CrtSurfaceBrush" Color="{StaticResource ColSurface}"/>
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ColElevated}"/>
    <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource ColInset}"/>
    <SolidColorBrush x:Key="CrtBorderBrush" Color="{StaticResource ColBorderSubtle}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource ColBorderStrong}"/>
    <SolidColorBrush x:Key="PhosphorWhiteBrush" Color="{StaticResource ColTextPrimary}"/>
    <SolidColorBrush x:Key="PhosphorDimBrush" Color="{StaticResource ColTextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColTextMuted}"/>
    <SolidColorBrush x:Key="AmberAlertBrush" Color="{StaticResource ColAmber}"/>
    <SolidColorBrush x:Key="AmberStrongBrush" Color="{StaticResource ColAmberStrong}"/>
    <SolidColorBrush x:Key="AmberDimBrush" Color="#26F0A03C"/>
    <SolidColorBrush x:Key="AmberFaintBrush" Color="#14F0A03C"/>
    <SolidColorBrush x:Key="TerminalGreenBrush" Color="{StaticResource ColSuccess}"/>
    <SolidColorBrush x:Key="SuccessDimBrush" Color="#2443B581"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColWarning}"/>
    <SolidColorBrush x:Key="HazardRedBrush" Color="{StaticResource ColDanger}"/>
    <SolidColorBrush x:Key="DangerDimBrush" Color="#24E5534B"/>
    <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource ColInfo}"/>
    <SolidColorBrush x:Key="ChannelRBrush" Color="{StaticResource ColChannelR}"/>
    <SolidColorBrush x:Key="ChannelGBrush" Color="{StaticResource ColChannelG}"/>
    <SolidColorBrush x:Key="ChannelBBrush" Color="{StaticResource ColChannelB}"/>
    <SolidColorBrush x:Key="OnAmberBrush" Color="#FF1A1208"/>

    <!-- ==================== 字体（契约键） ==================== -->
    <FontFamily x:Key="FontUi">Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Code, Consolas</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Semibold, Microsoft YaHei UI</FontFamily>

    <!-- ==================== 文本样式 ==================== -->
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ParamLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ParamValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PanelHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="16"/>
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ==================== 面板 ==================== -->
    <Style x:Key="TacticalPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CrtSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CrtBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="18,16"/>
    </Style>

    <!-- ==================== 次按钮：描边 + 悬浮底色 ==================== -->
    <Style x:Key="TacticalButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource TextMutedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 主按钮：琥珀实底 + 深色文字 ==================== -->
    <Style x:Key="TacticalButtonPrimary" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
        <Setter Property="Foreground" Value="{StaticResource OnAmberBrush}"/>
        <Setter Property="Background" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AmberStrongBrush}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource AmberStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#FFD18A2E"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 激活态按钮（运行中的「关闭滤镜」） ==================== -->
    <Style x:Key="TacticalButtonActive" TargetType="Button" BasedOn="{StaticResource TacticalButton}">
        <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="Background" Value="{StaticResource AmberFaintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource AmberDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="{StaticResource InsetBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 复选框 ==================== -->
    <Style x:Key="TacticalCheckBox" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                Background="{StaticResource InsetBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1.5"
                                VerticalAlignment="Top" Margin="0,1,9,0">
                            <Path x:Name="check" Data="M2.5,4.2 L4.4,6.2 L7.6,1.8"
                                  Stroke="{StaticResource OnAmberBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Width="9" Height="7"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{StaticResource AmberAlertBrush}"/>
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 滑杆 ==================== -->
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="knob" Width="14" Height="14"
                                 Fill="{StaticResource CrtBlackBrush}"
                                 Stroke="{StaticResource AmberAlertBrush}"
                                 StrokeThickness="2"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="knob" Property="Stroke" Value="{StaticResource AmberStrongBrush}"/>
                            <Setter TargetName="knob" Property="Width" Value="16"/>
                            <Setter TargetName="knob" Property="Height" Value="16"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="knob" Property="Fill" Value="{StaticResource AmberAlertBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource AmberAlertBrush}"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderTrackRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="4" CornerRadius="2" Background="{StaticResource ElevatedBrush}"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TacticalSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackFill}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackRest}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 下拉框 ==================== -->
    <Style x:Key="ComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{StaticResource InsetBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <ContentPresenter Margin="10,0,28,0" VerticalAlignment="Center"/>
                            <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource PhosphorDimBrush}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="9" Height="5" Stretch="None"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AmberAlertBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TacticalComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AmberDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource AmberAlertBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AmberFaintBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TacticalComboBox" TargetType="ComboBox">
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TacticalComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton" Style="{StaticResource ComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"/>
                        </ToggleButton>
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Background="Transparent" Foreground="{StaticResource PhosphorWhiteBrush}"/>
                        <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Slide" Focusable="False">
                            <Border x:Name="DropDownBorder" Background="{StaticResource ElevatedBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="4" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                    MaxHeight="280">
                                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 滚动条 ==================== -->
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="bd" CornerRadius="4" Margin="1,0"
                                                    Background="{StaticResource BorderStrongBrush}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource TextMutedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelScrollViewer" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}"/>
        </Style.Resources>
    </Style>

    <!-- ==================== 工具提示 ==================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PhosphorWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUi}"/>
        <Setter Property="FontSize" Value="11.5"/>
    </Style>

</ResourceDictionary>
